#!/usr/bin/env bash

set -euo pipefail

declare -ar TARGETS=(
    x86_64-unknown-windows-gnu
    x86_64-unknown-linux-musl
    x86_64-apple-darwin-none
    aarch64-unknown-linux-musl
    aarch64-apple-darwin-none
    riscv64-unknown-linux-musl
)

# GitHub Actions renders ::group:: sections in the log. Locally, print a
# readable title instead so the output does not look like noise.
if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
	group_start() { printf '::group::%s\n' "$1"; }
	group_end() { printf '::endgroup::\n'; }
else
	group_rule=$(printf '=%.0s' {1..80})
	group_start() { printf '%s\n==> %s\n%s\n' "$group_rule" "$1" "$group_rule"; }
	group_end() { printf '\n'; }
fi

group_start configure
# first shutdown cleanly and start a new server
sbt -client shutdown >/dev/null
sbt -no-colors -Dsbt.log.noformat=true -client 'project scalalsNative'
group_end

# Mode: {debug, release-fast, release-full, release-size}

declare -a binaries
declare targetDir

mapfile -n 1 -t targetDir < <(sbt -client 'print target')

for target in "${TARGETS[@]}"; do
    # LTO: {none, full, thin}
    case "$target" in
        # zig ld does not yet support LTO for mach-O see https://github.com/ziglang/zig/issues/8680
        *darwin*) LTO=none ;;
        # FIXME: with zig 0.15.2 using LTO leads to a runtime error:
        # ld.lld: error: linking module flags 'target-abi': IDs have conflicting values: '!"lp64d"' from target/out/native0.5/scala-3.10.0/scalals/native/dependencies/scalals_native0.5_3-0.1.13+234-7be7c181+20261113-1036-0/scala-native/win32_compat.c.o, and '[5 x i8] c"lp64d"' from ld-temp.o
        *risc*)   LTO=none ;;
        *)        LTO=full ;;
    esac

	group_start "build $target"

    sbt -client "set nativeConfig ~= { _.withLTO(scala.scalanative.build.LTO.$LTO) }"
    sbt -client "set targetTriplet:= Some(\"$target\")"
    sbt -client "ninja"
    sbt -client "ninjaCompile"

    ninja -f "$targetDir/build.ninja"

    binaries+=("$(ninja -f "$targetDir/build.ninja" -t targets rule exe)")

	group_end
done

mv -vt . "${binaries[@]}"
